# Environment & secrets — never commit (config comes from env/Vault)
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# Local tooling caches
/.cache/

# IDE / editor — keep shared .vscode settings, ignore personal/local ones
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# OS cruft
.DS_Store
Thumbs.db

# Maven
/target/

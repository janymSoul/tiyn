JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_TTL=168h
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
DATABASE_URL=postgres://tiyn:tiyn@localhost:5432/tiyn?sslmode=disable
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=15s
RELAY_INTERVAL=1s
RELAY_BATCH_SIZE=50
HANDLER_TIMEOUT=10s
DB_MAX_CONNS=20
HANDLER_RETRY_INITIAL=100ms
HANDLER_RETRY_MAX=500ms
RELAY_MAX_BACKOFF=5m
HANDLER_MAX_RETRIES=1
